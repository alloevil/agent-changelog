      "value": "MIT",
      "metric": "the LICENSE file",
      "method": "read the first line of the committed licence text",
      "repro": "head -1 LICENSE",
      "evidence": "LICENSE",
      "as_of": "2026-09-13",
      "check": {
        "cmd": "head -1 LICENSE | grep -c MIT | tr -d ' '",
        "expect": {
          "equals": "1"
        },
        "timeout": 60
      }
    }
  ]
}
